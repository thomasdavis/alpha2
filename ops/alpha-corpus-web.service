[Unit]
Description=Alpha public research workbench and read-only corpus explorer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ajax
Group=ajax
WorkingDirectory=/home/ajax/alpha2-web-current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3104
Environment=CORPUS_DB_PATH=/mnt/donto-data/donto-resources/research/alpha2-corpus/alpha-corpus.sqlite
ExecStart=/usr/bin/node apps/web/server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
Nice=5
MemoryMax=2G
TasksMax=256
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
