# Alpha public research workbench. The corpus route is public and read-only;
# mutation safety is enforced by the application and SQLite connection, not Caddy.
alpha.donto.org {
	log {
		output file /var/log/caddy/access.log {
			roll_size 100MiB
			roll_keep 10
		}
	}
	tls internal
	encode gzip zstd
	@legacy_api path /api/* /v1/* /chat/completions
	respond @legacy_api 404
	@non_read not method GET HEAD
	respond @non_read 405
	reverse_proxy 127.0.0.1:3104
}
