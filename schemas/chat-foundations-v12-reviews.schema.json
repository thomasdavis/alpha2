{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_batch_id", "reviews"],
  "properties": {
    "review_batch_id": { "type": "string", "minLength": 1 },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "decision",
          "semantic_correctness",
          "response_contingency",
          "relational_coherence",
          "naturalness",
          "shortcut_resistance",
          "scene_concerns",
          "fatal_concerns",
          "rationale"
        ],
        "properties": {
          "family_id": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "enum": ["accept", "reject"] },
          "semantic_correctness": { "type": "integer", "minimum": 1, "maximum": 5 },
          "response_contingency": { "type": "integer", "minimum": 1, "maximum": 5 },
          "relational_coherence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "naturalness": { "type": "integer", "minimum": 1, "maximum": 5 },
          "shortcut_resistance": { "type": "integer", "minimum": 1, "maximum": 5 },
          "scene_concerns": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "maxItems": 8
          },
          "fatal_concerns": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "maxItems": 8
          },
          "rationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
