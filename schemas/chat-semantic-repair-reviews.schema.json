{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_batch_id", "reviews"],
  "properties": {
    "review_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "decision",
          "semantic_correctness",
          "response_contingency",
          "naturalness",
          "compactness",
          "concern"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "type": "string",
            "enum": ["accept", "reject"]
          },
          "semantic_correctness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "response_contingency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "naturalness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "compactness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "concern": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
