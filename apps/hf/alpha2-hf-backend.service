[Unit]
Description=Alpha 60M public research-artifact inference backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ajax
Group=ajax
WorkingDirectory=/mnt/donto-data/workspace/alpha2
Environment=CHECKPOINT_PATH=/mnt/donto-data/alpha-runs/alpha-60m-continuation-c333bf2-20260730/hf-archive/checkpoints/sft-terminal-step-30322.alph
Environment=HOST=127.0.0.1
Environment=PORT=7860
ExecStart=/usr/bin/node /home/ajax/bin/alpha-60m-space-server.mjs
Restart=on-failure
RestartSec=10
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/mnt/donto-data/alpha-runs/alpha-60m-continuation-c333bf2-20260730/hf-archive/checkpoints/sft-terminal-step-30322.alph

[Install]
WantedBy=multi-user.target
