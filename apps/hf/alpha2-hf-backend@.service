[Unit]
Description=Alpha versioned inference backend (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ajax
Group=ajax
WorkingDirectory=/mnt/donto-data/workspace/alpha2
EnvironmentFile=/etc/alpha2-hf-backend/%i.env
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node /home/ajax/bin/alpha-versioned-space-server.mjs
Restart=on-failure
RestartSec=10
Nice=19
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=3G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/mnt/donto-data/alpha-runs

[Install]
WantedBy=multi-user.target
