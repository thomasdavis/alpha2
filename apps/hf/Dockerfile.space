# Hugging Face Space build context produced by scripts/publish_hf_space.py via `turbo prune --docker`.
FROM node:22-slim AS build
WORKDIR /app

COPY json/ ./
RUN npm ci
COPY full/ ./
RUN npx turbo build --filter=@alpha/hf...

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir huggingface_hub
ARG CHECKPOINT_REVISION=ffc447e8a0f2240d42ceb0abfd18ab5b427d5e60
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='ajaxdavis/alpha-60m-training-checkpoints', filename='checkpoints/chat-repair-selected-step-1200.alph', revision='${CHECKPOINT_REVISION}', local_dir='/app/model-files')"
RUN echo "399f776b49acc0c8834ff8a7f2390454e2c5f2d833a264e3f83ff546e973cfec  /app/model-files/checkpoints/chat-repair-selected-step-1200.alph" | sha256sum -c -

FROM node:22-slim
WORKDIR /app
COPY --from=build --chown=node /app/apps/hf/dist/index.js ./server.js
COPY --from=build --chown=node /app/model-files/checkpoints/chat-repair-selected-step-1200.alph ./checkpoint.alph

ENV CHECKPOINT_PATH=/app/checkpoint.alph
ENV PORT=7860
ENV HOST=0.0.0.0
USER node
EXPOSE 7860
CMD ["node", "server.js"]
