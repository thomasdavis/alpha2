[Unit]
Description=Post Alpha Corpus factual progress to Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ajax
Group=ajax
WorkingDirectory=/mnt/donto-data/workspace/alpha2
EnvironmentFile=/mnt/donto-data/workspace/alpha2/.env.discord.progress.local
ExecStart=/usr/bin/node /mnt/donto-data/workspace/alpha2/scripts/post-alpha-corpus-progress.mjs
Nice=19
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/donto-data/donto-resources/research/alpha2-corpus
